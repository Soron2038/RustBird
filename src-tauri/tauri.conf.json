{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustBird",
  "version": "1.1.12",
  "identifier": "com.rustbird.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RustBird",
        "width": 280,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/trayIconWhite.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERUY3Mzg1MkI5QUFBMEMKUldRTXFwb3JoWFB2VGFiVWJRb0xLSEIxMmNsVG9SV2FxSUo5ZFJxM0VzNWcraEVJRitSU2srSUwK",
      "endpoints": ["https://raw.githubusercontent.com/Soron2038/RustBird/main/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../assets/sounds/*": "sounds"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
